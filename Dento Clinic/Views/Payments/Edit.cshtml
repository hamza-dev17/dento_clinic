@model Dento_Clinic.Models.Entity.Payment

@{
    ViewBag.Title = "Edit Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <!-- Header -->
        <div class="card-header d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #1e3c72, #2a5298); color: white;">
            <div class="d-flex align-items-center">
                <!-- Icon for the header -->
                <i class="fas fa-edit mr-2"></i>
                <h4 class="mb-0" style="font-size: 1.5rem; font-weight: 600;">Update Payment</h4>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                @Html.HiddenFor(model => model.PaymentId) <!-- Hidden field for PaymentId -->

                <!-- Appointment ID Field -->
                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.AppointmentId, "Appointment Time", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.AppointmentId, (SelectList)ViewBag.AppointmentId, "Select an Appointment Time", new { @class = "form-control", @title = "Choose an appointment time" })
                    @Html.ValidationMessageFor(model => model.AppointmentId, "", new { @class = "text-danger" })
                </div>

                <!-- Amount Field -->
                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.Amount, "Amount", htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", @placeholder = "Enter amount" } })
                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                </div>

                <!-- Payment Date Field -->
                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.PaymentDate, "Payment Date", htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.PaymentDate, new { htmlAttributes = new { @class = "form-control", @type = "date" } })
                    @Html.ValidationMessageFor(model => model.PaymentDate, "", new { @class = "text-danger" })
                </div>

                <!-- Status Field -->
                <div class="form-group mb-3">
                    @Html.LabelFor(model => model.Status, "Status", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownListFor(model => model.Status, new SelectList(new List<string> { "Paid", "Pending" }), "Select Status", new { @class = "form-control", @title = "Choose the payment status" })
                    @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            }
        </div>
    </div>
</div>
