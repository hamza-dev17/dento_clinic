@model IEnumerable<Dento_Clinic.Models.Entity.Payment>

@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Card for the header -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Payments</h3>
        </div>
        <div class="card-body">
            <p>
                @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
            </p>

            <!-- Table to display data -->
            <div class="table-responsive">
                <table class="table table-striped table-bordered" id="myTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.PaymentId)</th> <!-- PaymentId column -->
                            <th>@Html.DisplayNameFor(model => model.AppointmentId)</th> <!-- AppointmentId column -->
                            <th>@Html.DisplayNameFor(model => model.Amount)</th> <!-- Amount column -->
                            <th>@Html.DisplayNameFor(model => model.PaymentDate)</th> <!-- PaymentDate column -->
                            <th>@Html.DisplayNameFor(model => model.Status)</th> <!-- Status column -->
                            <th style="text-align:center;">Actions</th> <!-- Actions column -->
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.PaymentId)</td> <!-- Display PaymentId -->
                                <td>@Html.DisplayFor(modelItem => item.AppointmentId)</td> <!-- Display AppointmentId -->
                                <td>@Html.DisplayFor(modelItem => item.Amount)</td> <!-- Display Amount -->
                                <td>@Html.DisplayFor(modelItem => item.PaymentDate)</td> <!-- Display PaymentDate -->
                                <td>@Html.DisplayFor(modelItem => item.Status)</td> <!-- Display Status -->
                                <td style="text-align:center;">
                                    @Html.ActionLink("Update", "Edit", new { id = item.PaymentId }, new { @class = "btn btn-success btn-sm", title = "Edit Payment" }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.PaymentId }, new { @class = "btn btn-danger btn-sm", title = "Delete Payment" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!--DataTable JavaScript Partial View -->
@Html.Partial("DataTableScript")
