@model Dento_Clinic.Models.Entity.Appointment

@{
    ViewBag.Title = "Delete Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <link href="~/Content/CustomCss/delete.css" rel="stylesheet" />
}

<div class="container mt-5">

    <!-- Appointment Details Section -->
    <div class="appointment-details">
        <div class="row">
            <div class="col-lg-6 col-md-12">
                <h4>Appointment Information</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AppointmentDate)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.AppointmentDate)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AppointmentTime)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.AppointmentTime)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>

                    <dt class="col-sm-4">D_Name</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Dentist.Name)</dd>

                    <dt class="col-sm-4">P_Name</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Patient.Name)</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Delete Button triggering SweetAlert -->
    <div class="mt-4">
        <button type="button" class="btn btn-danger" onclick="confirmDelete()">
            <i class="fas fa-trash"></i> Delete Appointment
        </button>
        <a href="@Url.Action("Index", "Appointments")" class="btn btn-secondary">
            <i class="fas fa-times"></i> Cancel
        </a>
    </div>

    <!-- Form for Deletion (hidden) -->
    @using (Html.BeginForm("DeleteConfirmed", "Appointments", FormMethod.Post, new { id = "deleteForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.AppointmentId)
    }

</div>

<!-- SweetAlert Script PartialView-->
@Html.Partial("SweetAlert")

