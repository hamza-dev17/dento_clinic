@model IEnumerable<Dento_Clinic.Models.Entity.Appointment>

@{
    ViewBag.Title = "Appointments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">
    <!-- Card for the header -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Appointments</h3>
        </div>
        <div class="card-body">
            <p>
                @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })

            </p>

            <!-- Table to display data -->
            <div class="table-responsive">
                <table class="table table-striped table-bordered" id="myTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.AppointmentDate)</th>
                            <th>@Html.DisplayNameFor(model => model.AppointmentTime)</th>
                            <th>@Html.DisplayNameFor(model => model.Status)</th>
                            <th>D_Name</th>
                            <th>@Html.DisplayNameFor(model => model.Patient.Name)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.AppointmentDate)</td>
                                <td>@Html.DisplayFor(modelItem => item.AppointmentTime)</td>
                                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                <td>@Html.DisplayFor(modelItem => item.Dentist.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Patient.Name)</td>
                                <td>

                                    @Html.ActionLink("Update", "Edit", new { id = item.AppointmentId }, new { @class = "btn btn-success btn-sm", title = "Edit Appointment" }) |
                                    @Html.ActionLink("Details", "Details", new { id = item.AppointmentId }, new { @class = "btn btn-info btn-sm", title = "View Details" }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.AppointmentId }, new { @class = "btn btn-danger btn-sm", title = "Delete Appointment" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>




<!--DataTable JavaScript Partial View -->
@Html.Partial("DataTableScript")