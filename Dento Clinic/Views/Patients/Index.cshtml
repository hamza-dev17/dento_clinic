@model IEnumerable<Dento_Clinic.Models.Entity.Patient>

@{
    ViewBag.Title = "Patients";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Card for the header -->
    <div class="card mb-4">
        <div class="card-header">
            <h3>Patients</h3>
        </div>
        <div class="card-body">
            <p>
                @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
            </p>

            <!-- Table to display data -->
            <div class="table-responsive">
                <table class="table table-striped table-bordered" id="myTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Name)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Phone)</th>
                            <th>@Html.DisplayNameFor(model => model.Address)</th>
                            <th>@Html.DisplayNameFor(model => model.DOB)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                <td>@Html.DisplayFor(modelItem => item.DOB)</td>
                                <td>
                                    @Html.ActionLink("Update", "Edit", new { id = item.PatientId }, new { @class = "btn btn-success btn-sm", title = "Edit Patient" }) |
                                    @Html.ActionLink("Delete", "Delete", new { id = item.PatientId }, new { @class = "btn btn-danger btn-sm", title = "Delete Patient" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- DataTable JavaScript Partial View -->
@Html.Partial("DataTableScript")
