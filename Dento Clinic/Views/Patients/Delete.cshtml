@model Dento_Clinic.Models.Entity.Patient

@{
    ViewBag.Title = "Delete Patient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <!-- Header -->
        <div class="card-header d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #1e3c72, #2a5298); color: white;">
            <div class="d-flex align-items-center">
                <!-- Icon for the header -->
                <i class="fas fa-trash-alt mr-2"></i>
                <h4 class="mb-0" style="font-size: 1.5rem; font-weight: 600;">Delete Patient</h4>
            </div>
        </div>
        <div class="card-body">
            <h3>Are you sure you want to delete this patient?</h3>
            <div>
                <h4>Patient Details</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Name)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Name)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Email)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Email)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Phone)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Phone)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.Address)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.Address)
                    </dd>

                    <dt class="col-sm-3">
                        @Html.DisplayNameFor(model => model.DOB)
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.DOB)
                    </dd>
                </dl>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                    <a href="@Url.Action("Index", "Patients")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            }
        </div>
    </div>
</div>
