<!-- loader -->
<div id="ftco-loader" class="show fullscreen">
    <svg class="circular" width="48px" height="48px">
        <circle class="path-bg" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke="#eeeeee" />
        <circle class="path" cx="24" cy="24" r="22" fill="none" stroke-width="4" stroke-miterlimit="10" stroke="#F96D00" />
    </svg>
</div>

<!-- Modal -->
<div class="modal fade" id="modalRequest" tabindex="-1" role="dialog" aria-labelledby="modalRequestLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content p-4 border-0 shadow-lg rounded-lg">
            <div class="modal-header border-0 d-flex justify-content-between align-items-center">
                <h5 class="modal-title text-primary font-weight-bold" id="modalRequestLabel">Contact Us</h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <!-- Contact Information -->
                <div class="text-center">
                    <p class="text-muted mb-4" style="font-size: 16px; font-weight: 400;">If you'd like to make an appointment, please contact us by phone or visit us in person:</p>
                    <!-- Phone Section -->
                    <div class="d-flex justify-content-center align-items-center mb-4">
                        <div class="icon-container bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mr-3" style="width: 50px; height: 50px;">
                            <i class="fas fa-phone-alt" style="font-size: 24px;"></i>
                        </div>
                        <p class="h5 font-weight-semibold text-dark">+ (053) 456 78 90</p>
                    </div>

                    <!-- Address Section -->
                    <div class="d-flex justify-content-center align-items-center mb-4">
                        <div class="icon-container bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mr-3" style="width: 50px; height: 50px;">
                            <i class="fas fa-map-marker-alt" style="font-size: 24px;"></i>
                        </div>
                        <p class="h5 font-weight-semibold text-dark">15 Temmuz mah 148051 Mah Sehitkamil/Gaziantep</p>
                    </div>

                    <!-- Subtle Footer Text -->
                    <p class="text-muted" style="font-size: 14px; font-weight: 300;">Our clinic is open for you Monday to Saturday. Reach out for more information!</p>
                </div>
            </div>
        </div>
    </div>
</div>


