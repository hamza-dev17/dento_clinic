<!-- Interactive map -->
<section id="map-section" style="height: 60vh; width: 100%; position: relative;">
    <div id="map" style="height: 100%; width: 100%;"></div>
</section>

<script>
    // Initialize Google Map
    function initMap() {
        var location = { lat: 37.0662, lng: 37.3833 }; // Coordinates for Gaziantep, Turkey
        var map = new google.maps.Map(document.getElementById('map'), {
            zoom: 14,
            center: location,
            disableDefaultUI: true, // Removes unnecessary UI elements
            styles: [
                {
                    "featureType": "all",
                    "elementType": "geometry",
                    "stylers": [{ "color": "#f2f2f2" }]
                },
                {
                    "featureType": "all",
                    "elementType": "labels.text.fill",
                    "stylers": [{ "color": "#333333" }]
                },
                {
                    "featureType": "landscape",
                    "elementType": "all",
                    "stylers": [{ "color": "#e6e6e6" }]
                }
            ]
        });

        // Use AdvancedMarkerElement (to avoid deprecated Marker)
        const marker = new google.maps.marker.AdvancedMarkerElement({
            position: location,
            map: map,
            title: "Gaziantep"
        });
    }
</script>

<script async defer src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDDkRFXKBJa0_oiZHhpZb01I5xxWKkFZNo&callback=initMap"></script>



